{
  "id": "athena-3d-default",
  "displayName": "Athena 3D Default",
  "provider": "gltf",
  "enabled": true,
  "model": {
    "source": "localDirectory",
    "rootPath": ".",
    "modelPath": "model/athena-3d-default.glb",
    "packageId": "athena-3d-default",
    "packageVersion": "0.1.0"
  },
  "layout": {
    "mode": "desktop_pet",
    "transform": {
      "x": 32,
      "y": 80,
      "scale": 1,
      "opacity": 1,
      "rotationDeg": 0,
      "mirrored": false
    },
    "alwaysOnTop": true,
    "clickThroughMode": "transparentOnly",
    "transparentBackground": true,
    "lockPosition": false
  },
  "expressions": [
    { "emotion": "peaceful", "expressionId": "peaceful", "intensityScale": 0.7, "fallbackExpressionId": "soft" },
    { "emotion": "happy", "expressionId": "happy", "intensityScale": 1 },
    { "emotion": "thoughtful", "expressionId": "thoughtful", "intensityScale": 0.85 },
    { "emotion": "shy", "expressionId": "shy", "intensityScale": 0.8, "fallbackExpressionId": "soft" },
    { "emotion": "confused", "expressionId": "confused", "intensityScale": 0.9, "fallbackExpressionId": "thoughtful" },
    { "emotion": "excited", "expressionId": "excited", "intensityScale": 1 },
    { "emotion": "tired", "expressionId": "tired", "intensityScale": 0.9 },
    { "emotion": "playful", "expressionId": "playful", "intensityScale": 0.9 },
    { "emotion": "soft", "expressionId": "soft", "intensityScale": 0.8 }
  ],
  "motions": [
    { "state": "idle", "motionGroup": "Idle", "priority": "idle", "loop": true, "fadeInMs": 450, "fadeOutMs": 450 },
    { "state": "listening", "motionGroup": "Listen", "priority": "focused", "loop": true, "fadeInMs": 250, "fadeOutMs": 300, "fallbackMotionGroup": "Idle" },
    { "state": "thinking", "motionGroup": "Think", "priority": "focused", "loop": true, "fadeInMs": 250, "fadeOutMs": 300, "fallbackMotionGroup": "Idle" },
    { "state": "streaming", "motionGroup": "Stream", "priority": "normal", "loop": true, "fadeInMs": 200, "fadeOutMs": 260, "fallbackMotionGroup": "Speak" },
    { "state": "speaking", "motionGroup": "Speak", "priority": "focused", "loop": true, "fadeInMs": 160, "fadeOutMs": 220, "fallbackMotionGroup": "Idle" },
    { "state": "interrupted", "motionGroup": "Interrupted", "priority": "urgent", "loop": false, "fadeInMs": 80, "fadeOutMs": 180, "fallbackMotionGroup": "Idle" },
    { "state": "error", "motionGroup": "Concerned", "priority": "urgent", "loop": false, "fadeInMs": 120, "fadeOutMs": 260, "fallbackMotionGroup": "Idle" },
    { "state": "sleepy", "motionGroup": "Sleepy", "priority": "idle", "loop": true, "fadeInMs": 500, "fadeOutMs": 500, "fallbackMotionGroup": "Idle" },
    { "state": "away", "motionGroup": "Away", "priority": "idle", "loop": true, "fadeInMs": 600, "fadeOutMs": 600, "fallbackMotionGroup": "Idle" }
  ],
  "parameters": [
    { "id": "ATH_MOUTH_NEUTRAL", "label": "Mouth Open", "min": 0, "max": 1, "defaultValue": 0, "favorite": true },
    { "id": "ATH_HEAD", "label": "Head Follow", "min": -1, "max": 1, "defaultValue": 0, "favorite": true },
    { "id": "ATH_EYE_L", "label": "Left Eye Follow", "min": -1, "max": 1, "defaultValue": 0, "favorite": false },
    { "id": "ATH_EYE_R", "label": "Right Eye Follow", "min": -1, "max": 1, "defaultValue": 0, "favorite": false },
    { "id": "ATH_HAIR_BACK", "label": "Hair Sway", "min": -1, "max": 1, "defaultValue": 0, "favorite": false },
    { "id": "ATH_SKIRT", "label": "Skirt Sway", "min": -1, "max": 1, "defaultValue": 0, "favorite": false }
  ],
  "lipSync": {
    "enabled": true,
    "source": "ttsAudio",
    "parameterIds": ["ATH_MOUTH_NEUTRAL"],
    "sensitivity": 1,
    "smoothing": 0.62,
    "gain": 1,
    "attackMs": 35,
    "releaseMs": 130,
    "minValue": 0,
    "maxValue": 1
  },
  "pointerTracking": {
    "enabled": true,
    "headParameterIds": ["ATH_HEAD"],
    "eyeParameterIds": ["ATH_EYE_L", "ATH_EYE_R"],
    "strength": 0.7,
    "smoothing": 0.48
  },
  "idle": {
    "enabled": true,
    "idleDelayMs": 30000,
    "sleepyDelayMs": 300000,
    "awayDelayMs": 900000,
    "motionGroups": ["Idle", "Think", "Sleepy"],
    "randomize": true
  },
  "hotZones": [
    {
      "id": "head",
      "label": "Head",
      "hitAreaName": "ATH_TARGET_HEAD",
      "action": {
        "type": "athenaReply",
        "promptTemplate": "用户轻触了你的头部。以 Athena 桌宠伴侣的身份，用自然、简短、温柔但不过度亲昵的中文回应。"
      },
      "cooldownMs": 1400,
      "enabled": true
    },
    {
      "id": "hair_clip",
      "label": "Hair Clip",
      "hitAreaName": "ATH_TARGET_HAIR_CLIP",
      "action": {
        "type": "composite",
        "actions": [
          { "type": "setExpression", "expressionId": "shy" },
          {
            "type": "athenaReply",
            "promptTemplate": "用户点到了你的银色发夹。用轻松、带一点害羞但克制的中文回应。"
          }
        ]
      },
      "cooldownMs": 1800,
      "enabled": true
    },
    {
      "id": "face",
      "label": "Face",
      "hitAreaName": "ATH_TARGET_FACE",
      "action": {
        "type": "athenaReply",
        "promptTemplate": "用户点了你的脸部区域。用自然、友好、保持边界感的中文回应。"
      },
      "cooldownMs": 1800,
      "enabled": true
    },
    {
      "id": "left_hand",
      "label": "Left Hand",
      "hitAreaName": "ATH_TARGET_HAND_L",
      "action": {
        "type": "athenaReply",
        "promptTemplate": "用户点了你的左手。用桌宠陪伴语气给出一句简短反馈，可以主动询问是否需要帮忙。"
      },
      "cooldownMs": 1400,
      "enabled": true
    },
    {
      "id": "right_hand",
      "label": "Right Hand",
      "hitAreaName": "ATH_TARGET_HAND_R",
      "action": {
        "type": "athenaReply",
        "promptTemplate": "用户点了你的右手。用轻快、简短的中文回应，避免夸张。"
      },
      "cooldownMs": 1400,
      "enabled": true
    }
  ],
  "externalControl": {
    "transport": "disabled",
    "enabled": false,
    "host": "127.0.0.1",
    "port": 0,
    "requireToken": true,
    "allowedCommandTypes": [
      "avatar.motion.play",
      "avatar.expression.set",
      "avatar.parameter.set",
      "avatar.pointer.move",
      "avatar.hotZone.trigger"
    ],
    "auditEnabled": true
  },
  "notes": "Default procedural GLB companion profile. Replace modelPath with a .vrm profile later without changing AvatarRuntime."
}
