  "provider": "live2d",
  "enabled": true,
  "model": {
    "source": "localDirectory",
    "rootPath": ".",
    "model3JsonPath": "Haru.model3.json",
    "packageId": "live2d-official-haru",
    "packageVersion": "official-sample-reference"
  },
  "marketplace": {
    "packageId": "live2d-official-haru",
    "version": "official-sample-reference",
    "displayName": "Haru Official Live2D Reference",
    "author": "Live2D Inc.",
    "license": "Live2D Free Material License / sample model terms",
    "homepage": "https://www.live2d.com/en/learn/sample/",
    "tags": ["reference", "official-sample", "quality-benchmark"]
  },
  "layout": {
    "mode": "desktop_pet",
    "transform": { "x": 32, "y": 80, "scale": 1, "opacity": 1, "rotationDeg": 0, "mirrored": false },
    "alwaysOnTop": true,
    "clickThroughMode": "transparentOnly",
    "transparentBackground": true,
    "lockPosition": false
  },
  "expressions": [
    { "emotion": "peaceful", "expressionId": "F01", "intensityScale": 1 },
    { "emotion": "happy", "expressionId": "F02", "intensityScale": 1 },
    { "emotion": "thoughtful", "expressionId": "F05", "intensityScale": 1 },
    { "emotion": "shy", "expressionId": "F04", "intensityScale": 1 },
    { "emotion": "confused", "expressionId": "F06", "intensityScale": 1 },
    { "emotion": "excited", "expressionId": "F03", "intensityScale": 1 },
    { "emotion": "tired", "expressionId": "F08", "intensityScale": 1 },
    { "emotion": "playful", "expressionId": "F07", "intensityScale": 1 },
    { "emotion": "soft", "expressionId": "F01", "intensityScale": 1 }
  ],
  "motions": [
    { "state": "idle", "motionGroup": "Idle", "priority": "idle", "loop": true, "fadeInMs": 500, "fadeOutMs": 500 },
    { "state": "listening", "motionGroup": "Listen", "priority": "focused", "loop": true, "fadeInMs": 350, "fadeOutMs": 450, "fallbackMotionGroup": "Idle" },
    { "state": "thinking", "motionGroup": "Think", "priority": "focused", "loop": true, "fadeInMs": 350, "fadeOutMs": 450, "fallbackMotionGroup": "Idle" },
    { "state": "streaming", "motionGroup": "Speak", "priority": "normal", "loop": true, "fadeInMs": 250, "fadeOutMs": 350, "fallbackMotionGroup": "Idle" },
    { "state": "speaking", "motionGroup": "Speak", "priority": "focused", "loop": true, "fadeInMs": 250, "fadeOutMs": 350, "fallbackMotionGroup": "Idle" },
    { "state": "interrupted", "motionGroup": "ShakeHead", "priority": "urgent", "loop": false, "fadeInMs": 200, "fadeOutMs": 350, "fallbackMotionGroup": "Idle" },
    { "state": "error", "motionGroup": "ShakeHead", "priority": "urgent", "loop": false, "fadeInMs": 200, "fadeOutMs": 350, "fallbackMotionGroup": "Idle" },
    { "state": "sleepy", "motionGroup": "Sleepy", "priority": "idle", "loop": true, "fadeInMs": 600, "fadeOutMs": 600, "fallbackMotionGroup": "Idle" },
    { "state": "away", "motionGroup": "Sleepy", "priority": "idle", "loop": true, "fadeInMs": 600, "fadeOutMs": 600, "fallbackMotionGroup": "Idle" }
  ],
  "parameters": [
    { "id": "ParamAngleX", "label": "Head X", "min": -30, "max": 30, "defaultValue": 0, "favorite": true },
    { "id": "ParamAngleY", "label": "Head Y", "min": -30, "max": 30, "defaultValue": 0, "favorite": true },
    { "id": "ParamAngleZ", "label": "Head Z", "min": -30, "max": 30, "defaultValue": 0, "favorite": true },
    { "id": "ParamEyeBallX", "label": "Eye X", "min": -1, "max": 1, "defaultValue": 0, "favorite": false },
    { "id": "ParamEyeBallY", "label": "Eye Y", "min": -1, "max": 1, "defaultValue": 0, "favorite": false },
    { "id": "ParamMouthOpenY", "label": "Mouth Open", "min": 0, "max": 1, "defaultValue": 0, "favorite": true },
    { "id": "ParamMouthForm", "label": "Mouth Form", "min": -1, "max": 1, "defaultValue": 0, "favorite": true }
  ],
  "lipSync": {
    "enabled": true,
    "source": "ttsAudio",
    "parameterIds": ["ParamMouthOpenY"],
    "sensitivity": 1,
    "smoothing": 0.62,
    "gain": 1,
    "attackMs": 35,
    "releaseMs": 130,
    "minValue": 0,
    "maxValue": 1
  },
  "pointerTracking": {
    "enabled": true,
    "headParameterIds": ["ParamAngleX", "ParamAngleY", "ParamAngleZ"],
    "eyeParameterIds": ["ParamEyeBallX", "ParamEyeBallY"],
    "strength": 0.7,
    "smoothing": 0.48
  },
  "idle": {
    "enabled": true,
    "idleDelayMs": 12000,
    "sleepyDelayMs": 300000,
    "awayDelayMs": 900000,
    "motionGroups": ["Idle"],
    "randomize": true
  },
  "hotZones": [
    { "id": "face", "label": "Face", "rect": { "x": 0.39, "y": 0.11, "width": 0.22, "height": 0.13 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "Nod" }, { "type": "setExpression", "expressionId": "F04" }, { "type": "athenaReply", "promptTemplate": "用户轻触了你的脸颊。以 Athena 桌宠伴侣身份，用自然、简短、温柔但不过度亲昵的中文回应。" }] }, "cooldownMs": 1400, "enabled": true },
    { "id": "hair", "label": "Hair", "rect": { "x": 0.31, "y": 0.03, "width": 0.38, "height": 0.16 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "TouchHair" }, { "type": "setExpression", "expressionId": "F07" }, { "type": "athenaReply", "promptTemplate": "用户轻触了你的头发。以 Athena 桌宠伴侣身份，给一句轻巧、自然、不过度亲昵的中文反馈。" }] }, "cooldownMs": 1400, "enabled": true },
    { "id": "head", "label": "Head", "hitAreaName": "Head", "rect": { "x": 0.32, "y": 0.04, "width": 0.36, "height": 0.28 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "TouchHead" }, { "type": "setExpression", "expressionId": "F04" }, { "type": "athenaReply", "promptTemplate": "用户轻触了你的头部。以 Athena 桌宠伴侣身份，用自然、简短、温柔但不过度亲昵的中文回应。" }] }, "cooldownMs": 1400, "enabled": true },
    { "id": "left_hand", "label": "Left hand", "rect": { "x": 0.19, "y": 0.50, "width": 0.12, "height": 0.20 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "TouchHand" }, { "type": "setExpression", "expressionId": "F02" }, { "type": "athenaReply", "promptTemplate": "用户轻触了你的手。以 Athena 桌宠伴侣身份，用自然、简短的中文回应，可以像在打招呼。" }] }, "cooldownMs": 1400, "enabled": true },
    { "id": "right_hand", "label": "Right hand", "rect": { "x": 0.69, "y": 0.50, "width": 0.12, "height": 0.20 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "Wave" }, { "type": "setExpression", "expressionId": "F02" }, { "type": "athenaReply", "promptTemplate": "用户轻触了你的手。以 Athena 桌宠伴侣身份，用自然、简短的中文回应，可以像在打招呼。" }] }, "cooldownMs": 1400, "enabled": true },
    { "id": "outfit", "label": "Outfit", "rect": { "x": 0.34, "y": 0.31, "width": 0.32, "height": 0.20 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "TouchOutfit" }, { "type": "setExpression", "expressionId": "F06" }, { "type": "athenaReply", "promptTemplate": "用户点了你的衣服区域。以 Athena 桌宠伴侣身份，用自然、简短、保持边界感的中文反馈。" }] }, "cooldownMs": 1400, "enabled": true },
    { "id": "skirt", "label": "Skirt", "rect": { "x": 0.31, "y": 0.49, "width": 0.38, "height": 0.18 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "ShakeHead" }, { "type": "setExpression", "expressionId": "F06" }, { "type": "athenaReply", "promptTemplate": "用户点了你的裙摆区域。以 Athena 桌宠伴侣身份，用自然、简短、明确保持边界感的中文回应。" }] }, "cooldownMs": 1800, "enabled": true },
    { "id": "body", "label": "Body", "hitAreaName": "Body", "rect": { "x": 0.28, "y": 0.31, "width": 0.44, "height": 0.42 }, "action": { "type": "composite", "actions": [{ "type": "playMotion", "motionGroup": "Greet" }, { "type": "athenaReply", "promptTemplate": "用户点了你的身体区域。用桌宠陪伴语气给出一句简短反馈，可以主动询问是否需要帮忙。" }] }, "cooldownMs": 1400, "enabled": true }
  ],
  "externalControl": {
    "transport": "disabled",
    "enabled": false,
    "host": "127.0.0.1",
