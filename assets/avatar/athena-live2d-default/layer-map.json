        "ATH_SKIRT_PLEAT_02",
        "ATH_SKIRT_PLEAT_03",
        "ATH_SKIRT_PLEAT_04",
        "ATH_SKIRT_PLEAT_05",
        "ATH_SKIRT_CYAN_ACCENT",
        "ATH_LEG_L",
        "ATH_LEG_R",
        "ATH_SOCK_L",
        "ATH_SOCK_R",
        "ATH_SHOE_L",
        "ATH_SHOE_R"
      ]
