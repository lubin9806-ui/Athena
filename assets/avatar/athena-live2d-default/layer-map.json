        "ATH_HAIR_SIDE_R",
        "ATH_HAIR_BANGS_CENTER",
        "ATH_HAIR_BANGS_L",
        "ATH_HAIR_BANGS_R",
        "ATH_HAIR_LOOSE_STRANDS",
        "ATH_ACCESSORY_HAIR_CLIP"
      ]
    },
    {
      "name": "Eyes",
      "requiredLayers": [
        "ATH_EYE_L_WHITE",
        "ATH_EYE_L_IRIS",
        "ATH_EYE_L_PUPIL",
        "ATH_EYE_L_HIGHLIGHT",
        "ATH_EYE_L_UPPER_LASH",
        "ATH_EYE_L_LOWER_LASH",
        "ATH_EYE_R_WHITE",
        "ATH_EYE_R_IRIS",
        "ATH_EYE_R_PUPIL",
