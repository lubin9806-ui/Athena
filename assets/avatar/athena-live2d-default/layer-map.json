        "ATH_MOUTH_FORM_U",
        "ATH_MOUTH_FORM_E",
        "ATH_MOUTH_FORM_O"
      ]
    },
    {
      "name": "Body",
      "requiredLayers": [
        "ATH_TORSO_BASE",
        "ATH_BLOUSE_BASE",
        "ATH_BLOUSE_COLLAR_L",
        "ATH_BLOUSE_COLLAR_R",
        "ATH_BLOUSE_SLEEVE_L",
        "ATH_BLOUSE_SLEEVE_R",
