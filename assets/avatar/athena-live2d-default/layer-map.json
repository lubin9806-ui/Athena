  "requiredHitAreas": [
    { "id": "Head", "targetLayers": ["ATH_HEAD_FACE_BASE", "ATH_HAIR_BANGS_CENTER"] },
    { "id": "HairClip", "targetLayers": ["ATH_ACCESSORY_HAIR_CLIP"] },
    { "id": "Face", "targetLayers": ["ATH_HEAD_FACE_BASE"] },
    { "id": "Shoulder", "targetLayers": ["ATH_BLOUSE_SLEEVE_L", "ATH_BLOUSE_SLEEVE_R"] },
    { "id": "Hand", "targetLayers": ["ATH_HAND_L", "ATH_HAND_R"] },
    { "id": "OutfitAccent", "targetLayers": ["ATH_BLOUSE_CYAN_TRIM", "ATH_SKIRT_CYAN_ACCENT"] }
  ],
  "requiredMotionGroups": [
    "Idle",
    "Greet",
    "Listen",
    "Think",
    "Speak",
    "Nod",
    "ShakeHead",
    "Wave",
    "TouchHead",
    "TouchHairClip",
    "Drag",
    "Return"
  ],
  "exportTarget": {
    "directory": "model",
    "model3Json": "model/athena-live2d-default.model3.json"
  }
}

