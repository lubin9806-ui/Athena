  "editorReadinessChecklist": [
    {
      "id": "source-art",
      "action": "Open the PSD and confirm every visible/hidden imported layer keeps its SSX_* name.",
      "evidence": [
        "source/su-shixia-front-layered-v1.psd",
        "source/parts/parts-contact-sheet-v1.png"
      ],
      "status": "manual_required"
    },
    {
      "id": "human-art-review",
      "action": "Review front alignment, hand/arm layering, lower-body occlusion, mouth shapes, hidden fill, and desktop-pet scale before rigging.",
      "evidence": [
        "source/review/front-alignment-preview-v1.png",
        "source/review/front-source-scale-preview-v1.png",
        "source/review/source-review-v1.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "parameters",
      "action": "Create all rig-spec parameters with exact IDs, ranges, defaults, and display groups.",
      "evidence": [
        "rig-spec.json",
        "su-shixia-live2d-v2.cdi3.template.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "meshes",
      "action": "Mesh every meshGroups part and preserve draw order for face, hair, arms, skirt, legs, and accessory.",
      "evidence": [
        "rig-spec.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "deformers",
      "action": "Create Root, Body, Head, Eyes, Mouth, Hair, Arms, Accessory, Skirt, and Legs deformers, then bind standard angle/breath/lip-sync parameters first.",
      "evidence": [
        "rig-spec.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "physics",
      "action": "Configure hair-front, hair-side, hair-back, and skirt physics from the template and tune after motion playback.",
      "evidence": [
        "su-shixia-live2d-v2.physics3.template.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "motions",
      "action": "Import or recreate all motion3 templates, then hand-polish touch reactions and recovery timing.",
      "evidence": [
        "motions/*.motion3.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "appearance",
      "action": "Bind ParamAccessoryHairClip. Do not claim true clothing swaps until new outfit drawables and parameters exist.",
      "evidence": [
        "rig-spec.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "export",
      "action": "Export moc3, model3, textures, physics, and display-info files into ../model, then verify they load with cubism-web instead of Live2D Lite.",
      "evidence": [
        "export-gate.json"
      ],
      "status": "manual_required"
    },
    {
      "id": "release-boundary",
      "action": "Keep source, handoff, adult-only, and private assets out of public installers until rights, license, and visual QA are approved.",
      "evidence": [
        "../manifest.json"
      ],
      "status": "manual_required"
    }
  ],
