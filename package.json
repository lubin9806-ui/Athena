{
  "name": "athena",
  "version": "0.9.0-beta.1",
  "private": true,
  "description": "Athena - local-first AI desktop companion (Desktop 0.9 private beta candidate)",
  "author": "Athena Project",
  "license": "UNLICENSED",
  "main": "dist/app/main.js",
  "scripts": {
    "dev": "node scripts/clean-dist.js && vite build --config vite.config.mts && tsc && electron .",
    "dev:renderer": "vite",
    "build": "node scripts/build-desktop.js --auto-sign",
    "build:release": "node scripts/build-desktop.js --require-signing",
    "build:steam": "node scripts/build-steam.js --require-signing --require-clean",
    "build:steam:engineering": "node scripts/build-steam.js",
    "release:manifest": "node scripts/generate-candidate-manifest.js",
    "release:verify": "electron scripts/verify-release-engineering.js",
    "release:channel": "node scripts/channel-control.js",
    "package:offline": "powershell.exe -ExecutionPolicy Bypass -NoProfile -File scripts\\package-offline.ps1",
    "audit:security": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "typecheck": "tsc --noEmit",
    "test:persona": "tsc && node scripts/verify-persona-prompt.js",
    "test:modes": "tsc && node scripts/verify-conversation-modes.js",
    "test:theme": "tsc && node scripts/verify-theme.js",
    "test:logger": "tsc && node scripts/verify-logger-pipe.js",
    "test:security": "tsc && node scripts/verify-security-baseline.js",
    "test:privacy": "tsc && electron scripts/verify-privacy-data.js",
    "test:supply-chain": "node scripts/verify-supply-chain.js",
    "test:release": "tsc && electron scripts/verify-release-engineering.js",
    "test:desktop-faults": "tsc && node scripts/verify-desktop-faults.js",
    "test:commercial": "tsc && node scripts/verify-commercial-readiness.js",
    "test:steam": "tsc && electron scripts/verify-steam.js && node scripts/verify-steam-candidate.js --source-only",
    "test:operations": "node scripts/verify-operations-readiness.js",
    "steam:verify-candidate": "node scripts/verify-steam-candidate.js",
    "test:web-search": "tsc && node scripts/verify-web-search.js",
    "test:web-search:live": "tsc && node scripts/verify-web-search.js --live",
    "test:web-search:e2e": "tsc && node scripts/verify-web-search.js --llm",
    "test:window05:arch": "tsc && node scripts/verify-window05-architecture.js",
    "test:window05:reliability": "tsc && node scripts/verify-window05-reliability.js",
    "test:window05": "npm.cmd run test:web-search && npm.cmd run test:window05:arch && npm.cmd run test:window05:reliability",
    "test:tools": "tsc && node scripts/verify-computer-tools.js",
    "test:tools:live": "tsc && node scripts/verify-computer-tools.js --live",
    "smoke:electron": "node scripts/clean-dist.js && vite build --config vite.config.mts && tsc && electron . --smoke-test",
    "clean:dist": "node scripts/clean-dist.js",
    "db:stats": "python scripts/db-tool.py stats",
    "db:reindex": "python scripts/db-tool.py reindex",
    "rebuild:sqlite:electron": "npm.cmd rebuild better-sqlite3 --runtime=electron --target=42.7.0 --disturl=https://electronjs.org/headers",
    "import:sushixia": "python scripts/import-su-shixia-chat-record.py",
    "start": "electron .",
    "desktop": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "electron": "42.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron-winstaller": false
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  }
}
