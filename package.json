{
  "name": "athena",
  "version": "0.9.6-beta.1",
  "private": true,
  "description": "Athena - local-first AI desktop companion (Desktop 0.9.6-beta.1 private beta candidate)",
  "author": "Athena Project",
  "license": "UNLICENSED",
  "main": "dist/app/main.js",
  "scripts": {
    "dev": "node scripts/clean-dist.js && vite build --config vite.config.mts && tsc && electron .",
    "dev:renderer": "vite",
    "build": "node scripts/build-desktop.js --auto-sign",
    "build:release": "node scripts/build-desktop.js --require-signing",
    "release:preflight": "node scripts/verify-signing-prerequisites.js",
    "release:verify-candidate": "node scripts/verify-private-beta-candidate.js",
    "build:steam": "node scripts/build-steam.js --require-signing --require-clean",
    "build:steam:engineering": "node scripts/build-steam.js",
    "build:store": "node scripts/build-microsoft-store.js --require-clean",
    "build:store:engineering": "node scripts/build-microsoft-store.js",
    "release:manifest": "node scripts/generate-candidate-manifest.js",
    "release:verify": "electron scripts/verify-release-engineering.js",
    "release:channel": "node scripts/channel-control.js",
    "package:offline": "powershell.exe -ExecutionPolicy Bypass -NoProfile -File scripts\\package-offline.ps1",
    "prepare:voice-runtime": "node scripts/prepare-voice-runtime.js",
    "audit:security": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "typecheck": "tsc --noEmit",
    "test:live2d:runtime": "tsc && node scripts/verify-live2d-cubism-runtime.js",
    "test:live2d:realtime": "tsc && node scripts/verify-live2d-realtime-controls.js",
    "test:live2d:motion": "node scripts/generate-live2d-motion-assets.js && node scripts/repair-live2d-alpha-fringe.js && tsc && node scripts/verify-live2d-motion-assets.js",
    "test:live2d:expressions": "node scripts/generate-live2d-expression-assets.js && tsc && node scripts/verify-live2d-expression-assets.js",
    "test:live2d:integration": "tsc && node scripts/verify-live2d-athena-integration.js",
    "test:live2d:desktop-pet": "node scripts/clean-dist.js && vite build --config vite.config.mts && tsc && node scripts/verify-live2d-desktop-pet.js",
    "test:live2d:package": "node scripts/verify-live2d-release-package.js",
    "test:live2d:su-shixia-source": "node scripts/build-su-shixia-live2d-source.js && node scripts/verify-su-shixia-live2d-source.js",
    "test:live2d:su-shixia-runtime": "node scripts/build-su-shixia-live2d-source.js && node scripts/generate-su-shixia-live2d-lite-runtime.js && node scripts/generate-su-shixia-cubism-handoff.js && node scripts/generate-su-shixia-live2d-visual-qa.js && node scripts/generate-su-shixia-cubism-runtime-proof-template.js && node scripts/audit-su-shixia-cubism-export.js && node scripts/audit-su-shixia-live2d-delivery.js && node scripts/generate-su-shixia-review-dashboard.js && tsc && node scripts/verify-su-shixia-live2d-source.js && node scripts/verify-su-shixia-live2d-runtime.js && node scripts/verify-su-shixia-cubism-handoff.js && node scripts/verify-su-shixia-live2d-visual-qa.js && node scripts/verify-su-shixia-cubism-runtime-proof-template.js && node scripts/verify-su-shixia-live2d-delivery-audit.js && node scripts/verify-su-shixia-review-dashboard.js",
    "test:live2d:su-shixia-cubism-audit": "node scripts/audit-su-shixia-cubism-export.js",
    "test:live2d:su-shixia-cubism-required": "node scripts/audit-su-shixia-cubism-export.js --require-go",
    "test:live2d:su-shixia-cubism-proof-template": "node scripts/generate-su-shixia-cubism-runtime-proof-template.js && node scripts/verify-su-shixia-cubism-runtime-proof-template.js",
    "test:live2d:su-shixia-delivery-audit": "node scripts/audit-su-shixia-live2d-delivery.js && node scripts/verify-su-shixia-live2d-delivery-audit.js",
    "test:live2d:su-shixia-review-dashboard": "node scripts/audit-su-shixia-live2d-delivery.js && node scripts/generate-su-shixia-review-dashboard.js && node scripts/verify-su-shixia-review-dashboard.js",
    "test:persona": "tsc && node scripts/verify-persona-prompt.js",
    "test:modes": "tsc && node scripts/verify-conversation-modes.js",
    "test:chat-windows": "tsc && electron scripts/verify-chat-windows.js",
    "test:theme": "tsc && node scripts/verify-theme.js",
    "test:memory-retention": "tsc && electron scripts/verify-memory-retention.js",
    "test:logger": "tsc && node scripts/verify-logger-pipe.js",
    "test:security": "tsc && node scripts/verify-security-baseline.js",
    "test:privacy": "tsc && electron scripts/verify-privacy-data.js",
    "test:supply-chain": "node scripts/verify-supply-chain.js",
    "test:release": "tsc && electron scripts/verify-release-engineering.js",
    "test:private-beta": "node scripts/verify-private-beta-candidate.js --self-test",
    "test:update-policy": "tsc && node scripts/verify-update-policy.js",
    "test:desktop-faults": "tsc && node scripts/verify-desktop-faults.js",
    "test:desktop-reliability": "tsc && electron scripts/verify-desktop-reliability.js",
    "test:desktop-package": "node scripts/verify-desktop-package.js",
    "test:commercial": "tsc && node scripts/verify-commercial-readiness.js",
    "test:steam": "tsc && electron scripts/verify-steam.js && node scripts/verify-steam-candidate.js --source-only",
    "test:store": "tsc && node scripts/verify-microsoft-store.js --source-only",
    "store:verify-package": "node scripts/verify-microsoft-store.js",
    "test:operations": "node scripts/verify-operations-readiness.js",
    "steam:verify-candidate": "node scripts/verify-steam-candidate.js",
    "test:web-search": "tsc && node scripts/verify-web-search.js",
    "test:web-search:live": "tsc && node scripts/verify-web-search.js --live",
    "test:web-search:e2e": "tsc && node scripts/verify-web-search.js --llm",
    "test:window05:arch": "tsc && node scripts/verify-window05-architecture.js",
    "test:window05:reliability": "tsc && electron scripts/verify-window05-reliability.js",
    "test:window05": "npm.cmd run test:web-search && npm.cmd run test:window05:arch && npm.cmd run test:window05:reliability",
    "test:voice-runtime": "node scripts/verify-voice-runtime.js",
    "test:voice:e2e": "tsc && electron scripts/verify-voice-e2e.js",
    "test:tools": "tsc && node scripts/verify-computer-tools.js",
    "test:tools:live": "tsc && node scripts/verify-computer-tools.js --live",
    "test:model-providers": "tsc && electron scripts/verify-model-providers.js",
    "test:model-adapters": "tsc && node scripts/verify-model-adapters.js",
    "test:agent-foundation": "tsc && electron scripts/verify-agent-foundation.js",
    "test:agent-runtime": "tsc && electron scripts/verify-agent-runtime.js",
    "test:project-workspace": "tsc && electron scripts/verify-project-workspace.js",
    "test:skill-library": "tsc && node scripts/verify-skill-library.js",
    "test:mcp-integrations": "tsc && node scripts/verify-mcp-integrations.js",
    "test:research-tools": "tsc && node scripts/verify-research-tools.js",
    "test:artifact-tools": "tsc && electron scripts/verify-artifact-tools.js",
    "test:chat-attachments": "tsc && electron scripts/verify-chat-attachments.js",
    "test:project-memory": "tsc && electron scripts/verify-project-memory-isolation.js",
    "test:project-documents": "tsc && electron scripts/verify-project-documents.js && node -e \"console.log('ATHENA_PROJECT_DOCUMENTS_OK formats=txt,md,docx,pdf isolation=project citations=locator cleanup=managed ocr=local')\"",
    "test:local-ocr": "tsc && electron scripts/verify-local-ocr.js",
    "test:packaged-ocr": "electron scripts/verify-packaged-ocr.js",
    "test:diagnostics": "tsc && electron scripts/verify-diagnostics.js",
    "test:agent-routing": "tsc && node scripts/verify-agent-routing.js",
    "test:agent-evals": "npm.cmd run test:agent-routing && npm.cmd run test:web-search && npm.cmd run test:agent-runtime && npm.cmd run test:project-workspace && npm.cmd run test:research-tools && npm.cmd run test:project-memory && npm.cmd run test:skill-library",
    "test:deepseek:live": "tsc && electron scripts/verify-deepseek-live-chat.js",
    "smoke:electron": "node scripts/clean-dist.js && vite build --config vite.config.mts && tsc && electron . --smoke-test",
    "clean:dist": "node scripts/clean-dist.js",
    "db:stats": "python scripts/db-tool.py stats",
    "db:reindex": "python scripts/db-tool.py reindex",
    "rebuild:sqlite:electron": "node scripts/rebuild-sqlite-electron.js",
    "import:sushixia": "python scripts/import-su-shixia-chat-record.py",
    "start": "electron .",
    "desktop": "electron ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/canvas": "1.0.6",
    "@pixiv/three-vrm": "^3.5.5",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "docx": "9.7.1",
    "electron-updater": "6.8.9",
    "jszip": "3.10.1",
    "mammoth": "1.12.1",
    "pdfjs-dist": "6.2.108",
    "pixi.js": "8.20.0",
    "tesseract.js": "7.0.0",
    "three": "^0.185.1",
    "untitled-pixi-live2d-engine": "1.3.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@types/three": "^0.185.4",
    "ag-psd": "^31.0.2",
    "electron": "42.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron-winstaller": false,
    "tesseract.js@7.0.0": false
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  }
}
