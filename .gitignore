# OS
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# Local model/runtime payloads: tracked code must reference exact release manifests,
# not commit multi-GB developer-machine artifacts.
models/
resources/OllamaSetup.exe
resources/voice-runtime/

# Root-level voice and download probes retained under legacy/root-artifacts.
test*.mp3
test*.wav
tts_*.mp3
tts_txt_*.txt
stt_test_*.txt
public.zip

# Preserve the audit manifest while excluding the archived binary payloads.
legacy/root-artifacts/**
!legacy/root-artifacts/README.md
!legacy/root-artifacts/MANIFEST.sha256
