# Local-only values. Never reuse them outside an isolated test environment.
ATHENA_CLOUD_ENV=local
ATHENA_CLOUD_HOST=127.0.0.1
ATHENA_CLOUD_PORT=8787
ATHENA_CLOUD_DB=./data/athena-cloud.db
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATHENA_CLOUD_MASTER_KEY_BASE64=
ATHENA_CLOUD_TLS_TERMINATED=false
ATHENA_CLOUD_REGION=local-1
ATHENA_CLOUD_PROVIDER=local
ATHENA_CLOUD_BILLING_ADAPTER=local-no-charge
ATHENA_CLOUD_RECOVERY_DELIVERY_ADAPTER=local-return-token
ATHENA_CLOUD_MODEL_PROVIDER=local-fixture
ATHENA_CLOUD_SEARCH_PROVIDER=local-fixture
